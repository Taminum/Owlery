#!/bin/sh /etc/rc.common
# RemnaScope router agent: reads the sing-box Clash API and reports traffic per LAN device.
# Read-only. State and spool live in /tmp (RAM), so nothing is written to flash.
START=99
STOP=10
USE_PROCD=1

start_service() {
	mkdir -p /tmp/remnascope-agent
	chmod 700 /tmp/remnascope-agent
	procd_open_instance
	procd_set_param command /usr/bin/remnascope-agent \
		-server wss://scope.example.com/ingest/v1 \
		-token-file /etc/remnascope/agent.token \
		-state-dir /tmp/remnascope-agent \
		-clash-url http://192.168.1.1:9090 \
		-leases-file /tmp/dhcp.leases \
		-spool-max-mb 2 \
		-batch-lines 200
	procd_set_param env GOGC=50 GOMEMLIMIT=16MiB
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
