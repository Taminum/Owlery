# TLS terminates here; Caddy gets and renews the Let's Encrypt certificate by itself.
{$SCOPE_HOST} {
	encode gzip
	header Strict-Transport-Security "max-age=31536000"
	# Everything goes to the bundled nginx, which serves the UI, proxies /api and the agents'
	# WebSocket (/ingest/), and sets the security headers. Caddy adds X-Forwarded-For with the real client.
	reverse_proxy web:8080 {
		header_up X-Forwarded-For {remote_host}
	}
	# Access log without request or response headers: they can carry cookies and tokens.
	log {
		output stdout
		format filter {
			wrap console
			fields {
				request>headers delete
				resp_headers delete
			}
		}
	}
}
